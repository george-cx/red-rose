    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.1",
    "tailwind-merge": "^2.6.0",
