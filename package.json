{
  "name": "red-rose",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "prebuild": "tsx scripts/verify-fonts.ts",
    "build": "next build && tsx scripts/post-export.ts",
